{
  "name": "arctic_tests",
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "test:modules": "mocha --config tests/modules/.mocharc.json",
    "test:precompiles": "mocha --config tests/precompiles/.mocharc.json",
    "test:precompiles:all": "bash scripts/runPrecompiles.sh",
    "test:precompiles:gov": "mocha --config tests/precompiles/.mocharc.gov.json",
    "test:tokens": "mocha --config tests/tokens/.mocharc.json",
    "test:wasm-existing": "mocha --config tests/tokens/.mocharc.existingWasm.json",
    "test:rpc-node": "mocha --config tests/rpc_node_tests/.mocharc.json",
    "test:dynamic-rpc": "mocha --require tsx --timeout 600000 --exit tests/dynamic_rpc/dynamicRpc.spec.ts",
    "test:evm-rpc": "mocha --config tests/evm_rpc/.mocharc.json",
    "test:chain": "mocha --config tests/chain_tests/.mocharc.json",
    "test:mempool": "mocha --config tests/mempool/.mocharc.json",
    "rpc:geth": "geth --dev --http --http.addr 127.0.0.1 --http.port 9547 --http.api eth,net,web3,debug,txpool --dev.period 0 --verbosity 2",
    "rpc:fork": "hardhat --config tests/new_rpc_tests/hardhat/hardhat.config.ts node --port 9546 --hostname 127.0.0.1",
    "rpc:bootstrap": "mocha --config tests/new_rpc_tests/.mocharc.bootstrap.json",
    "rpc:run": "mocha --config tests/new_rpc_tests/.mocharc.run.json",
    "test:rpc": "npm run rpc:bootstrap && npm run rpc:run",
    "test:reports:merge": "mochawesome-merge \"reports/*/*.json\" -o reports/combined/combined-report.json && marge reports/combined/combined-report.json -o reports/combined --reportFilename combined-report",
    "test:reported": "(npm run test:precompiles; npm run test:tokens; npm run test:rpc-node; npm run test:evm-rpc; npm run test:modules; npm run test:chain; npm run test:mempool); npm run test:reports:merge"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@sei-js/cosmos": "^1.0.5",
    "@testomatio/reporter": "^2.3.0",
    "@types/express": "^5.0.3",
    "@types/lodash": "^4.17.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.1",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "ethers": "^6.13.5",
    "hardhat": "^2.23.0",
    "lodash": "^4.17.21",
    "mochawesome-merge": "^5.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@0xmonaco/contracts": "^0.1.8",
    "@0xmonaco/core": "0.2.14",
    "@0xmonaco/types": "0.2.11",
    "@account-abstraction/contracts": "^0.8.0",
    "@cosmjs/cosmwasm-stargate": "^0.33.1",
    "@cosmjs/stargate": "^0.33.1",
    "@duneanalytics/client-sdk": "^0.2.5",
    "@openzeppelin/contracts-upgradeable": "^5.3.0",
    "@sei-js/proto": "^4.1.0",
    "axios": "^1.10.0",
    "bech32": "^2.0.0",
    "cosmjs-types": "^0.9.0",
    "ed25519-supercop": "^2.0.1",
    "express": "^5.1.0",
    "googleapis": "^149.0.0",
    "graphql-request": "^7.1.2",
    "mocha": "11.1.0",
    "mochawesome": "^7.1.3",
    "prom-client": "^15.1.3",
    "viem": "^2.37.1"
  }
}
