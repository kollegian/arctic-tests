    "tests/solo_evm/rpc_tests/state_endpoints/eth_estimateGas.spec.ts",
    "tests/solo_evm/rpc_tests/debug_endpoints/debug_traceCall.spec.ts",
    "tests/solo_evm/rpc_tests/debug_endpoints/debug_traceTx.spec.ts",
