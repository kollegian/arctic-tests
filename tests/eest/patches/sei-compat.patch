diff --git a/tests/conftest.py b/tests/conftest.py
new file mode 100644
index 000000000..5c16ae210
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,150 @@
+"""Sei-specific skips for known remote-execution incompatibilities."""
+
+import pytest
+
+EIP2929_PERSISTENT_STATE_CASES = {
+    "new0",
+    "new3",
+    "new8",
+    "new9",
+    "new10",
+    "new11",
+    "new12",
+    "new13",
+    "new14",
+    "all2",
+    "all3",
+    "new15",
+    "new16",
+    "new17",
+    "new18",
+    "new19",
+    "new20",
+    "new21",
+    "new22",
+    "all4",
+    "all5",
+    "yes124",
+    "yes150",
+}
+
+EIP2930_FLOOR_GAS_CASES = {
+    "access_list_empty-data_1_zero_byte",
+    "access_list_empty-data_4_zero_byte",
+    "access_list_empty-data_1_non_zero_byte",
+    "access_list_empty-data_1_zero_byte_1_non_zero_byte",
+    "access_list_empty-data_1_zero_byte_1_non_zero_byte_reversed",
+    "access_list_empty-data_set_1",
+    "access_list_empty-data_set_2",
+    "access_list_empty-data_set_3",
+    "access_list_empty-data_set_31_bytes",
+    "access_list_empty-data_set_32_bytes",
+    "access_list_empty-data_set_33_bytes",
+    "access_list_empty-data_set_33_empty_bytes",
+    "access_list_empty-data_set_66_bytes_half_zeros",
+    "access_list_1_address_empty_keys-data_set_66_bytes_half_zeros",
+}
+
+EIP6780_REPEATED_SELFDESTRUCT_CASES = {
+    "multiple_calls_single_self_recipient",
+    "multiple_calls_multiple_sendall_recipients_including_self_last",
+    "multiple_calls_multiple_repeating_sendall_recipients_including_self",
+    "multiple_calls_multiple_repeating_sendall_recipients_including_self_last",
+}
+
+PRECOMPILE_ONE = "precompile_0x0000000000000000000000000000000000000001"
+PRECOMPILE_FOUR = "precompile_0x0000000000000000000000000000000000000004"
+
+
+def _known_failure_reason(item: pytest.Item) -> str | None:
+    nodeid = item.nodeid
+    name = item.name
+    originalname = getattr(item, "originalname", None)
+
+    if (
+        "tests/prague/eip7623_increase_calldata_cost/"
+        "test_transaction_validity.py" in nodeid
+        and "insufficient_gas-floor_gas_greater_than_intrinsic_gas" in name
+        and "-unprotected-" not in name
+    ):
+        return "Known Sei EIP-7623 transaction-admission issue."
+
+    if (
+        "tests/berlin/eip2930_access_list/test_tx_intrinsic_gas.py" in nodeid
+        and "fork_Prague-" in name
+        and "below_intrinsic_True" in name
+        and any(case_id in name for case_id in EIP2930_FLOOR_GAS_CASES)
+    ):
+        return "Known Sei EIP-7623 floor-data-gas admission issue."
+
+    if (
+        "tests/cancun/eip6780_selfdestruct/test_selfdestruct.py" in nodeid
+        and originalname == "test_create_selfdestruct_same_tx"
+        and any(
+            case_id in name
+            for case_id in EIP6780_REPEATED_SELFDESTRUCT_CASES
+        )
+    ):
+        return "Known Sei EIP-6780 repeated-SELFDESTRUCT issue."
+
+    if (
+        "tests/ported_static/stPreCompiledContracts/"
+        "test_precomps_eip2929_cancun.py" in nodeid
+        and originalname == "test_precomps_eip2929_cancun"
+        and any(
+            name.endswith(f"-{case_id}]")
+            for case_id in EIP2929_PERSISTENT_STATE_CASES
+        )
+    ):
+        return (
+            "Persistent remote state changes this vector's account-existence "
+            "assumptions."
+        )
+
+    if (
+        "tests/tangerine_whistle/eip150_operation_gas_costs/"
+        "test_eip150_selfdestruct.py" in nodeid
+        and originalname
+        in {
+            "test_selfdestruct_to_precompile",
+            "test_selfdestruct_to_precompile_state_access_boundary",
+        }
+        and (
+            PRECOMPILE_ONE in name
+            or PRECOMPILE_FOUR in name
+        )
+        and "dead_beneficiary-no_balance" in name
+        and name.endswith("-exact_gas]")
+    ):
+        return (
+            "Persistent remote chains cannot restore the precompile balance "
+            "to zero."
+        )
+
+    if (
+        "tests/constantinople/eip1052_extcodehash/test_extcodehash.py"
+        in nodeid
+    ):
+        if (
+            originalname == "test_extcodehash_precompile"
+            and (
+                PRECOMPILE_ONE in name
+                or PRECOMPILE_FOUR in name
+            )
+        ) or (
+            originalname == "test_extcodehash_dynamic_argument"
+            and "target_type_precompile]" in name
+        ):
+            return (
+                "Persistent precompile balances change EXTCODEHASH from zero "
+                "to KECCAK256_EMPTY."
+            )
+
+    return None
+
+
+def pytest_collection_modifyitems(items: list[pytest.Item]) -> None:
+    """Skip confirmed Sei failures while retaining adjacent passing vectors."""
+    for item in items:
+        if reason := _known_failure_reason(item):
+            item.add_marker(pytest.mark.skip(reason=reason))
