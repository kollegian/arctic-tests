+UNAVAILABLE_SYSTEM_CONTRACTS = (
+    "system_contract_0x0000f90827f1c53a10cb7a02335b175320002935",
+    "system_contract_0x000f3df6d732807ef1319fb7b8bb8522d0beac02",
+)
+
+
+def pytest_collection_modifyitems(items: list[pytest.Item]) -> None:
+    """Skip cases requiring Ethereum system-contract bytecode absent from Sei."""
+    for item in items:
+        if item.originalname != "test_set_code_to_system_contract":
+            continue
+        if any(contract in item.name for contract in UNAVAILABLE_SYSTEM_CONTRACTS):
+            item.add_marker(
+                pytest.mark.skip(
+                    reason="Sei genesis does not contain Ethereum system-contract bytecode"
+                )
+            )
